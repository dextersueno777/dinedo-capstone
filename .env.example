# DineDo local development environment example
# Never commit real production secrets.

NODE_ENV=development

# App URLs
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# PostgreSQL local Docker database
POSTGRES_DB=dinedo
POSTGRES_USER=dinedo_user
POSTGRES_PASSWORD=dinedo_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dinedo_user:dinedo_password@localhost:5432/dinedo?schema=public

# Redis local Docker service
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Authentication placeholders for local development only
JWT_ACCESS_SECRET=replace-with-local-access-secret
JWT_REFRESH_SECRET=replace-with-local-refresh-secret

# Upload rules
MAX_UPLOAD_MB=5

# Philippine timezone
APP_TIMEZONE=Asia/Manila

# Local seed account only
SEED_ADMIN_EMAIL=admin@dinedo.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=DineDo
SEED_ADMIN_LAST_NAME=Admin

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Mapbox Directions API
# Server-side token only. Do not expose this as NEXT_PUBLIC.
MAPBOX_ACCESS_TOKEN=

DEMO_MODE_ENABLED=true
DEMO_ACCOUNT_EMAIL=dextersueno0808@gmail.com
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_VERIFICATION_SECRET=
STAFF_TEST_EMAIL_ENABLED=false
STAFF_TEST_EMAIL=
STAFF_TEST_PHONE_ENABLED=false
STAFF_TEST_PHONE=
