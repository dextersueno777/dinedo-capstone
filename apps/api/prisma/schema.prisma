generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  KITCHEN
  RIDER
}

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

enum MenuOptionGroupType {
  SINGLE
  MULTIPLE
}

enum ServiceType {
  DINE_IN
  TAKE_OUT
  DELIVERY
}

enum OrderTimingType {
  IMMEDIATE
  ADVANCE
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  MODIFICATION_REQUESTED
  CANCELLED
  COOKING
  READY_FOR_PICKUP
  READY_TO_SERVE
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  COMPLETED
}

enum PaymentMethod {
  COD
  GCASH_MANUAL
  PAY_AT_COUNTER
  PAY_AFTER_EATING
}

enum PaymentState {
  UNPAID
  PROOF_SUBMITTED
  APPROVED
  REJECTED
  PAID
  REFUND_PENDING
  REFUNDED
}

enum DeliveryFeeStatus {
  NOT_REQUIRED
  PENDING_STAFF_REVIEW
  PENDING_CUSTOMER_ACCEPTANCE
  ACCEPTED
  REJECTED
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TableStatus {
  ACTIVE
  INACTIVE
}

enum PaymentProofStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum RefundMethod {
  GCASH_MANUAL
  CASH_MANUAL
}

enum RiderAvailabilityStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
  DISABLED
}

enum RiderShiftStatus {
  OPEN
  CLOSED
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  REJECTED_BY_RIDER
  OUT_FOR_DELIVERY
  ARRIVED
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryIssueStatus {
  OPEN
  REVIEWING
  RESOLVED
  CANCELLED
}

enum ProofOfDeliveryType {
  PHOTO
  SIGNATURE
  ADMIN_BYPASS
}

enum CodRemittanceStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

model Branch {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  address   String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  settings       BranchSettings?
  users          User[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  carts          Cart[]
  tables         RestaurantTable[]
  reservations   Reservation[]
  riderProfiles RiderProfile[]
  riderShifts   RiderShift[]
  deliveries    Delivery[]
  codRemittances CodRemittance[]

  @@index([status])
}

model BranchSettings {
  id                  String   @id @default(cuid())
  branchId            String   @unique
  timezone            String   @default("Asia/Manila")
  orderingOpenTime    String   @default("08:00")
  orderingCloseTime   String   @default("18:00")
  normalDeliveryKm    Decimal  @default(1.00) @db.Decimal(8, 2)
  reservationsEnabled Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model User {
  id           String     @id @default(cuid())
  branchId     String?
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  branch          Branch?          @relation(fields: [branchId], references: [id])
  profile         UserProfile?
  refreshSessions RefreshSession[]
  favorites       Favorite[]
  addresses       Address[]
  carts           Cart[]
  orders          Order[]              @relation("CustomerOrders")
  statusUpdates   OrderStatusHistory[] @relation("OrderStatusActor")
  reservations    Reservation[]        @relation("CustomerReservations")
  uploadedPaymentProofs PaymentProof[] @relation("PaymentProofUploader")
  reviewedPaymentProofs PaymentProof[] @relation("PaymentProofReviewer")
  customerRefunds Refund[]             @relation("CustomerRefunds")
  requestedRefunds Refund[]            @relation("RefundRequester")
  processedRefunds Refund[]            @relation("RefundProcessor")
  riderProfile RiderProfile?
  riderShifts RiderShift[]              @relation("RiderShifts")
  assignedDeliveries Delivery[]          @relation("AssignedDeliveries")
  reportedDeliveryIssues DeliveryIssue[] @relation("DeliveryIssueReporter")
  capturedProofs ProofOfDelivery[]       @relation("ProofOfDeliveryCapturer")
  codRemittances CodRemittance[]         @relation("RiderCodRemittances")
  verifiedCodRemittances CodRemittance[] @relation("CodRemittanceVerifier")

  @@index([branchId])
  @@index([role])
  @@index([status])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model MenuCategory {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([branchId, slug])
  @@index([branchId])
  @@index([isActive])
}

model MenuItem {
  id          String         @id @default(cuid())
  branchId    String
  categoryId  String
  name        String
  slug        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  status      MenuItemStatus @default(AVAILABLE)
  isFeatured  Boolean        @default(false)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     MenuCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images       MenuItemImage[]
  optionGroups MenuOptionGroup[]
  favorites    Favorite[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([branchId, slug])
  @@index([branchId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
}

model MenuItemImage {
  id         String   @id @default(cuid())
  menuItemId String
  url        String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

model MenuOptionGroup {
  id          String              @id @default(cuid())
  menuItemId  String
  name        String
  type        MenuOptionGroupType
  isRequired  Boolean             @default(false)
  minSelect   Int                 @default(0)
  maxSelect   Int                 @default(1)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuOption[]

  @@index([menuItemId])
}

model MenuOption {
  id             String   @id @default(cuid())
  optionGroupId  String
  name           String
  priceDelta     Decimal  @default(0.00) @db.Decimal(10, 2)
  isAvailable    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  optionGroup      MenuOptionGroup  @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  cartItemOptions  CartItemOption[]
  orderItemOptions OrderItemOption[]

  @@index([optionGroupId])
  @@index([isAvailable])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([userId])
  @@index([menuItemId])
}


model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String
  recipient    String
  phoneNumber  String
  line1        String
  barangay     String?
  municipality String
  province     String
  postalCode   String?
  landmark     String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@index([isDefault])
}

model Cart {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@unique([branchId, userId])
  @@index([branchId])
  @@index([userId])
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  menuItemId   String
  quantity     Int
  specialNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart     Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  options  CartItemOption[]

  @@index([cartId])
  @@index([menuItemId])
}

model CartItemOption {
  id           String  @id @default(cuid())
  cartItemId   String
  menuOptionId String
  quantity     Int     @default(1)
  priceDelta   Decimal @default(0.00) @db.Decimal(10, 2)

  cartItem   CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Restrict)

  @@unique([cartItemId, menuOptionId])
  @@index([cartItemId])
  @@index([menuOptionId])
}


model Order {
  id                          String            @id @default(cuid())
  orderNumber                 String            @unique
  branchId                    String
  customerId                  String
  addressId                   String?
  serviceType                 ServiceType
  timingType                  OrderTimingType
  scheduledFor                DateTime?
  status                      OrderStatus        @default(PENDING)
  paymentMethod               PaymentMethod
  paymentState                PaymentState       @default(UNPAID)
  deliveryFeeStatus           DeliveryFeeStatus  @default(NOT_REQUIRED)
  subtotalAmount              Decimal           @default(0.00) @db.Decimal(10, 2)
  discountAmount              Decimal           @default(0.00) @db.Decimal(10, 2)
  deliveryFeeAmount           Decimal           @default(0.00) @db.Decimal(10, 2)
  additionalDeliveryFeeAmount Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount                 Decimal           @default(0.00) @db.Decimal(10, 2)
  customerNotes               String?
  adminNotes                  String?
  cancellationReason          String?
  preparationStartedAt        DateTime?
  cancelledAt                 DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  deletedAt                   DateTime?

  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  address       Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reservation   Reservation?
  paymentProofs PaymentProof[]
  refunds       Refund[]
  delivery      Delivery?

  @@index([branchId])
  @@index([customerId])
  @@index([addressId])
  @@index([status])
  @@index([paymentState])
  @@index([createdAt])
  @@index([scheduledFor])
}


model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  menuItemId   String
  itemName     String
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal  @db.Decimal(10, 2)
  specialNotes String?
  createdAt    DateTime @default(now())

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  options  OrderItemOption[]

  @@index([orderId])
  @@index([menuItemId])
}

model OrderItemOption {
  id              String  @id @default(cuid())
  orderItemId     String
  menuOptionId    String
  optionGroupName String
  optionName      String
  priceDelta      Decimal @default(0.00) @db.Decimal(10, 2)
  quantity        Int     @default(1)

  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  menuOption MenuOption @relation(fields: [menuOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([menuOptionId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  reason      String?
  notes       String?
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation("OrderStatusActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([changedById])
  @@index([toStatus])
  @@index([createdAt])
}


model RestaurantTable {
  id          String      @id @default(cuid())
  branchId    String
  name        String
  capacity    Int
  status      TableStatus @default(ACTIVE)
  location    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  reservations ReservationTable[]

  @@unique([branchId, name])
  @@index([branchId])
  @@index([status])
}

model Reservation {
  id                String            @id @default(cuid())
  reservationNumber String            @unique
  branchId          String
  customerId        String
  linkedOrderId     String?           @unique
  status            ReservationStatus @default(PENDING)
  reservedFor       DateTime
  guestCount        Int
  customerName      String
  customerPhone     String
  notes             String?
  downPaymentAmount Decimal           @default(0.00) @db.Decimal(10, 2)
  totalEstimate     Decimal           @default(0.00) @db.Decimal(10, 2)
  adminNotes        String?
  rejectionReason   String?
  cancellationReason String?
  approvedAt        DateTime?
  cancelledAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer    User               @relation("CustomerReservations", fields: [customerId], references: [id], onDelete: Restrict)
  linkedOrder Order?             @relation(fields: [linkedOrderId], references: [id], onDelete: SetNull)
  tables      ReservationTable[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([reservedFor])
  @@index([createdAt])
}

model ReservationTable {
  id            String   @id @default(cuid())
  reservationId String
  tableId       String
  createdAt     DateTime @default(now())

  reservation Reservation    @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)

  @@unique([reservationId, tableId])
  @@index([reservationId])
  @@index([tableId])
}


model PaymentProof {
  id                   String             @id @default(cuid())
  orderId              String
  uploadedById          String
  reviewedById          String?
  status               PaymentProofStatus @default(PENDING_REVIEW)
  amount               Decimal            @db.Decimal(10, 2)
  proofImageUrl         String
  gcashReferenceNumber  String?
  payerName             String?
  payerAccountLast4     String?
  rejectionReason       String?
  reviewNotes           String?
  submittedAt           DateTime           @default(now())
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation("PaymentProofUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("PaymentProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([uploadedById])
  @@index([reviewedById])
  @@index([status])
  @@index([submittedAt])
}

model Refund {
  id                   String       @id @default(cuid())
  orderId              String
  customerId           String
  requestedById         String?
  processedById         String?
  status               RefundStatus @default(PENDING)
  method               RefundMethod @default(GCASH_MANUAL)
  amount               Decimal      @db.Decimal(10, 2)
  reason               String
  adminNotes           String?
  gcashReferenceNumber  String?
  refundProofImageUrl   String?
  requestedAt           DateTime     @default(now())
  processedAt           DateTime?
  completedAt           DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    User  @relation("CustomerRefunds", fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy User? @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  processedBy User? @relation("RefundProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId])
  @@index([requestedById])
  @@index([processedById])
  @@index([status])
  @@index([requestedAt])
}


model RiderProfile {
  id                 String                  @id @default(cuid())
  userId             String                  @unique
  branchId           String
  availabilityStatus RiderAvailabilityStatus @default(OFF_DUTY)
  vehicleType        String?
  plateNumber        String?
  emergencyContact   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([availabilityStatus])
}

model RiderShift {
  id        String           @id @default(cuid())
  branchId  String
  riderId   String
  status    RiderShiftStatus @default(OPEN)
  startedAt DateTime         @default(now())
  endedAt   DateTime?
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rider  User   @relation("RiderShifts", fields: [riderId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([riderId])
  @@index([status])
  @@index([startedAt])
}


model Delivery {
  id                      String         @id @default(cuid())
  branchId                String
  orderId                 String         @unique
  riderId                 String?
  status                  DeliveryStatus @default(PENDING_ASSIGNMENT)
  assignedAt              DateTime?
  acceptedAt              DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  outForDeliveryAt        DateTime?
  arrivedAt               DateTime?
  deliveredAt             DateTime?
  cancelledAt             DateTime?
  failedAt                DateTime?
  issueSummary            String?
  navigationAddress       String?
  customerContactSnapshot String?
  codAmountToCollect      Decimal        @default(0.00) @db.Decimal(10, 2)
  deliveryFeeAmount       Decimal        @default(0.00) @db.Decimal(10, 2)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  deletedAt               DateTime?

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider  User?  @relation("AssignedDeliveries", fields: [riderId], references: [id], onDelete: SetNull)

  issues DeliveryIssue[]
  proofs ProofOfDelivery[]
  codRemittanceItems CodRemittanceDelivery[]

  @@index([branchId])
  @@index([orderId])
  @@index([riderId])
  @@index([status])
  @@index([assignedAt])
  @@index([deliveredAt])
}


model DeliveryIssue {
  id          String              @id @default(cuid())
  deliveryId  String
  reportedById String?
  status      DeliveryIssueStatus @default(OPEN)
  title       String
  description String
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  resolvedAt  DateTime?
  deletedAt   DateTime?

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reportedBy User?    @relation("DeliveryIssueReporter", fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([reportedById])
  @@index([status])
  @@index([createdAt])
}

model ProofOfDelivery {
  id           String              @id @default(cuid())
  deliveryId   String
  capturedById String?
  type         ProofOfDeliveryType
  imageUrl     String?
  signatureUrl String?
  notes        String?
  capturedAt   DateTime            @default(now())
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?

  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  capturedBy User?    @relation("ProofOfDeliveryCapturer", fields: [capturedById], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([capturedById])
  @@index([type])
  @@index([capturedAt])
}


model CodRemittance {
  id              String              @id @default(cuid())
  branchId        String
  riderId         String
  verifiedById    String?
  status          CodRemittanceStatus @default(PENDING)
  remittanceDate  DateTime
  expectedAmount  Decimal             @default(0.00) @db.Decimal(10, 2)
  submittedAmount Decimal?            @db.Decimal(10, 2)
  varianceAmount  Decimal             @default(0.00) @db.Decimal(10, 2)
  proofImageUrl   String?
  riderNotes      String?
  adminNotes      String?
  submittedAt     DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  rider      User   @relation("RiderCodRemittances", fields: [riderId], references: [id], onDelete: Restrict)
  verifiedBy User?  @relation("CodRemittanceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  deliveries CodRemittanceDelivery[]

  @@index([branchId])
  @@index([riderId])
  @@index([verifiedById])
  @@index([status])
  @@index([remittanceDate])
}

model CodRemittanceDelivery {
  id              String   @id @default(cuid())
  codRemittanceId String
  deliveryId      String
  amount          Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  codRemittance CodRemittance @relation(fields: [codRemittanceId], references: [id], onDelete: Cascade)
  delivery      Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@unique([codRemittanceId, deliveryId])
  @@index([codRemittanceId])
  @@index([deliveryId])
}
