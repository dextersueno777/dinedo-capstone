{
  "name": "dinedo",
  "version": "0.1.0",
  "private": true,
  "description": "DineDo PWA for ordering, table reservation, and delivery management at Dindo's Restaurant - Tinoc Branch.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "echo \"Run app-specific dev commands after apps are created.\"",
